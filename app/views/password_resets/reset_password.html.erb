<div class="row-fluid">
  <h2 style="text-align: center;">MetaCorp</h2>
  <h3 style="text-align: center;">A GoatGroup Company</h3>
  <div class="span12">
    <div class="row-fluid">
      <div class="span4 offset4">

        <div class="signup">
          <%= form_tag "password_resets", :class=> "signup-wrapper" do %>

          <div class="header">
            <h2>Create Password</h2>
            <p>Fill out the form below to create a new password.</p>
          </div>

          <div class="content">
            <%= hidden_field_tag 'token', @reset_token %>
            <%= label_tag "Enter Password" %>
            <%= password_field_tag :password, '', {:class => "input input-block-level", :autocomplete => "new-password"} %>
            <%= label_tag "Confirm Password" %>
            <%= password_field_tag :confirm_password, '', {:class => "input input-block-level", :autocomplete => "new-password"} %>
          </div>

          <div class="actions">
            <%= submit_tag "Create Password", {:class => "btn btn-danger btn-large"} %>
          </div>

          <div class="clearfix"></div>
          <% end %>
        </div>

      </div>
    </div>
  </div>
</div>